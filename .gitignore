# --- Build Outputs ---
# Excludes all build folders and generated binaries
**/build/
*.apk
*.aab
*.ap_
*.dex

# --- Android Studio / IntelliJ ---
# Excludes IDE-specific configuration and local paths
.idea/
*.iml
.gradle/
local.properties
captures/
.externalNativeBuild
.cxx/
*.stackdump

# --- Secrets & Signing (CRITICAL) ---
# Never share these; they are required for publishing and private keys
*.jks
*.keystore
*.gpg
key.properties
google-services.json

# --- OS Specific ---
# Clean up system files
.DS_Store
Thumbs.db
*~
*.swp

# --- Kotlin/Kapt ---
# Excludes temporary files generated during Kotlin/Kapt compilation
.kotlin/