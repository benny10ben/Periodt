<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="40dp"
    android:layout_weight="1">

    <!--
        Strip fills full cell height so the rounded caps on start/end
        are tall enough to look like semicircles — matching CalendarCard.
        fitXY fills width edge-to-edge for seamless middle pieces.
    -->
    <ImageView
        android:id="@+id/day_strip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- Day number centered on top -->
    <TextView
        android:id="@+id/day_text"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="14sp"
        android:fontFamily="@font/bricolage_grotesque"
        android:textColor="@color/widget_text_primary"
        android:background="@android:color/transparent" />

    <!-- Today ring on top of everything -->
    <ImageView
        android:id="@+id/today_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>