<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12.dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/widget_text_primary"
                android:textSize="22sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/title_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="@font/bricolage_grotesque"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/widget_text_primary"
                android:textSize="22sp"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">
            <TextView style="@style/WidgetWeekdayLabel" android:text="S" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="M" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="T" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="W" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="T" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="F" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="S" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>